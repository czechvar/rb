DATABASE_URL=postgresql://user:password@host/dbname
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Cloudflare R2 (S3-compatible) file storage — all four required to enable R2;
# if unset, Payload falls back to local disk storage.
R2_BUCKET=your-bucket-name
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Public site URL — used in email templates and OAuth-style return URLs.
# Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Canonical structured-data identity. These can differ from NEXT_PUBLIC_SITE_URL
# in local/dev so JSON-LD still points at the production brand and domain.
STRUCTURED_DATA_SITE_URL=https://rockbusters.net
STRUCTURED_DATA_BUSINESS_NAME=Rockbusters

# Resend transactional email. If RESEND_API_KEY is unset, Payload falls back
# to its console adapter (logs emails to stdout) — same defensive pattern as
# the R2 fallback above. Forgot-password and email verification will appear
# in the dev console instead of being sent.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=Rockbusters
EMAIL_REPLY_TO=

# Comgate payment gateway (card payments). Sandbox credentials from the
# Comgate merchant portal; COMGATE_TEST_MODE defaults to sandbox (true)
# unless explicitly set to "false" — never let a missing/mistyped value
# accidentally enable real charges.
COMGATE_MERCHANT=
COMGATE_SECRET=
COMGATE_TEST_MODE=true

# Search-engine indexing. Opt-in and fails safe: anything other than "true"
# serves a disallow-all robots.txt plus X-Robots-Tag: noindex. Leave unset on
# beta.rockbusters.net; set to "true" only on the live production domain.
SITE_INDEXABLE=
