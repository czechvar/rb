{
  "name": "rb-scaffold",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "check:theme-css": "node scripts/check-theme-css.mjs",
    "check:theme-registry": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/check-theme-registry.ts",
    "check:theme-css:strict": "node scripts/check-theme-css.mjs --strict",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "cleanup:block-demo": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/cleanup-block-demo.ts",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed.ts",
    "data-import:extract": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/data-import/extract.ts",
    "data-import:import": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/data-import/import.ts",
    "data-import:guides": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/data-import/import.ts --only=guides",
    "data-import:locations": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/data-import/import.ts --only=locations",
    "data-import:legacy-destinations": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/data-import/import-legacy-destinations.ts",
    "data-import:fetch-airports": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/data-import/fetch-airports-seed.ts",
    "data-import:airports": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/data-import/import-airports-seed.ts",
    "data-import:extract-legacy-airports": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/data-import/legacy/extract-legacy-airports.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.84.1",
    "@payloadcms/email-resend": "3.84.1",
    "@payloadcms/next": "3.84.1",
    "@payloadcms/plugin-mcp": "3.84.1",
    "@payloadcms/richtext-lexical": "3.84.1",
    "@payloadcms/storage-s3": "3.84.1",
    "@payloadcms/ui": "3.84.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.2.6",
    "payload": "3.84.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.6",
    "jsdom": "28.0.0",
    "mysql2": "^3.24.2",
    "prettier": "^3.4.2",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
