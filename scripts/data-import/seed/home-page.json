              {
                "type": "paragraph",
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "text": "Rockbusters is a community of guides, coaches, and passionate climbers who have made rock climbing our entire life. We don't guide on the side — this is it for us.",
                    "type": "text",
                    "version": 1
                  }
                ],
                "direction": null
              },
              {
                "type": "paragraph",
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "\nEvery trip and course we run is built around one thing: maximum quality and quantity of climbing. Technical mastery, mental game, movement efficiency — we coach it all, on the same crags where the world's best do their hardest routes.",
                    "type": "text",
                    "version": 1
                  }
                ],
                "direction": null
              }
            ],
            "direction": null
          }
