                    "format": "",
                    "indent": 0,
                    "direction": null,
                    "children": [
                      {
                        "type": "text",
                        "version": 1,
                        "text": "No refunds are provided for camps purchased at a discount through a third party. Cancellations made 30 days in advance of a camp will be held as a credit to be used for any Rockbuster's camp for 6 months from the cancellation date.",
                        "format": 0,
                        "detail": 0,
                        "mode": "normal",
                        "style": ""
