                    "format": "",
                    "indent": 0,
                    "direction": null,
                    "children": [
                      {
                        "type": "text",
                        "version": 1,
                        "text": "In case of a sudden and unexpected incident (e.g. injury, sickness ) the payment can be transferred to another activity/action of the Provider that takes place within six months from the date of the initial activity/action.",
                        "format": 0,
                        "detail": 0,
                        "mode": "normal",
                        "style": ""
                      }
